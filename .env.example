# Copy to .env for local development. Never commit the real .env file.
# Every value here is either a local-dev default or a placeholder — see
# docs/DEPLOYMENT.md for what production configuration will require once the
# Hetzner environment is finalized (rule 30: no infra specifics assumed yet).

NODERA_ENV=development

# PostgreSQL is the system of record (ADR-003). The docker-compose.yml
# service matches these credentials for local dev only.
NODERA_DATABASE_URL=postgres://nodera:nodera_dev_password@localhost:5432/nodera?sslmode=disable
NODERA_DATABASE_MAX_CONNS=10

# Used only by integration tests (internal/testhelpers) — a separate
# database so tests never touch dev data.
NODERA_TEST_DATABASE_URL=postgres://nodera:nodera_dev_password@localhost:5432/nodera_test?sslmode=disable

NODERA_HTTP_ADDR=:8080

# Comma-separated browser origins allowed to call this API cross-origin
# (see internal/platform/httpserver.CORS). Defaults to the web/ dev server
# if unset. Production must set this explicitly to its real frontend
# origin(s) — see docs/DEPLOYMENT.md.
NODERA_CORS_ORIGINS=http://localhost:3000

# Optional. If unset, rate limiting falls back to an in-process limiter
# (correct for a single instance, not shared across one) and job queueing
# stays Postgres-backed. If set, login/signup/AI-chat rate limiting becomes
# Redis-backed and shared across every API process instance pointed at the
# same Redis — see internal/platform/ratelimit. A misconfigured (unreachable)
# URL fails startup rather than silently falling back.
NODERA_REDIS_URL=redis://localhost:6379

# Used only by integration tests (internal/platform/ratelimit) — a distinct
# logical DB index so tests never touch dev data. Tests are skipped, not
# failed, if unset.
NODERA_TEST_REDIS_URL=redis://localhost:6379/1

# debug | info (default)
NODERA_LOG_LEVEL=info

# Optional. Base64-encoded 32-byte AES-256 key for internal/secrets. If
# unset, the secrets module is disabled (its endpoints return UNAVAILABLE)
# rather than the server failing to start. Generate one with:
#   openssl rand -base64 32
NODERA_SECRETS_ENCRYPTION_KEY=

# Optional. Base URL of an Ollama-compatible local inference server (e.g.
# http://localhost:11434). If unset, the 'ollama' provider adapter is not
# registered — an AI profile referencing it simply fails with UNAVAILABLE
# rather than the server failing to start. See docs/AI_ARCHITECTURE.md.
NODERA_OLLAMA_BASE_URL=

# Optional. A real Anthropic API key — treat this with the same care as
# NODERA_DATABASE_URL: never commit a real value, never log it. If unset,
# the 'anthropic' cloud provider adapter is not registered — an AI profile
# referencing it simply fails with UNAVAILABLE rather than the server
# failing to start. See docs/AI_ARCHITECTURE.md.
NODERA_ANTHROPIC_API_KEY=

# Optional. A real OpenAI API key — same handling as
# NODERA_ANTHROPIC_API_KEY (a genuine secret, never committed or logged).
# If unset, the 'openai' cloud provider adapter is not registered. See
# docs/AI_ARCHITECTURE.md.
NODERA_OPENAI_API_KEY=

# Optional. The email of an already-signed-up user to grant every platform
# permission (internal/platformauth) at every startup — idempotent, safe to
# leave set permanently. The explicit, operator-controlled mechanism for
# establishing the first platform administrator; see docs/SECURITY.md
# "Platform vs organization authorization". A nonexistent email just logs
# a warning, never fails startup.
NODERA_PLATFORM_BOOTSTRAP_ADMIN_EMAIL=
