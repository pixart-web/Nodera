# Production / staging configuration for docker-compose.prod.yml.
# Copy to /etc/nodera/nodera.env (root:root, 0640). It holds NO SECRETS — secrets
# are files under /etc/nodera/secrets (scripts/init-secrets.sh). It is safe to
# include in the control-plane backup, and it is.
#
#   docker compose -f docker-compose.prod.yml --env-file /etc/nodera/nodera.env up -d

# --- Required ---
# Public hostname of the UI and API (ONE host: the proxy routes /api/ and /agent/ to the API).
NODERA_HOST=nodera.example.com
# Immutable image references: a version tag or an @sha256 digest — never "latest".
# Tags come from the Release workflow (docs/RELEASES.md).
NODERA_API_IMAGE=ghcr.io/pixart-web/nodera-api:0.0.0
NODERA_WEB_IMAGE=ghcr.io/pixart-web/nodera-web:0.0.0
NODERA_AGENT_IMAGE=ghcr.io/pixart-web/nodera-agent:0.0.0
# Subnet of the dedicated edge network (only Traefik, api and web are on it):
#   docker network inspect nodera-edge --format '{{(index .IPAM.Config 0).Subnet}}'
NODERA_TRUSTED_PROXIES=172.30.0.0/16
# GID of the host's docker group (the agent needs it for the socket): getent group docker | cut -d: -f3
NODERA_DOCKER_GID=999

# --- Host layout (defaults shown) ---
# NODERA_SECRETS_DIR=/etc/nodera/secrets
# NODERA_SECRETS_GID=10100              # group that may read the secret files
# NODERA_DATA_HOST_DIR=/srv/nodera/data # shared by api + agent; owned by uid 10001
# NODERA_EDGE_NETWORK=nodera-edge       # dedicated Traefik <-> api/web network (docker network create nodera-edge)
# NODERA_PROXY_NETWORK=proxy-public     # shared network that WORKLOAD containers join
# NODERA_CERT_RESOLVER=letsencrypt      # Traefik certificate resolver name

# --- First administrator ---
# Email of a user that has ALREADY signed up; granted every platform permission at start-up.
# NODERA_PLATFORM_BOOTSTRAP_ADMIN_EMAIL=

# --- Set AFTER the agent is enrolled (runbook step "Enrol the agent") ---
# NODERA_LOCAL_AGENT_ID=

# --- Managed workloads on this node ---
# NODERA_BASE_DOMAIN=apps.example.com    # adds Traefik routing labels for <slug>.<base domain>
# Existing MariaDB container the agent manages through `docker exec` (root password: secrets/mariadb-root-password)
# NODERA_MARIADB_CONTAINER=mariadb
# NODERA_WORDPRESS_DB_HOST=mariadb
# NODERA_MARIADB_LEGACY_CLIENT=true      # only for MariaDB < 10.5 (mysql/mysqldump instead of mariadb/mariadb-dump)
# Containers managed operations may never stop/remove, in addition to nodera-cp-* and anything
# labelled nodera.role=control-plane:
# NODERA_PROTECTED_CONTAINERS=traefik,mariadb

# --- Off-site backups of customer workloads (docs/BACKUPS.md) ---
# NODERA_BACKUP_DESTINATION=sftp
# NODERA_BACKUP_SFTP_ADDR=uXXXXXX.your-storagebox.de:23
# NODERA_BACKUP_SFTP_USER=uXXXXXX
# NODERA_BACKUP_SFTP_DIR=nodera-backups
# Pin the server's host key (ssh-keyscan -p 23 HOST | ssh-keygen -lf -). Binding the key type is recommended:
# NODERA_BACKUP_SFTP_HOST_KEY_SHA256=ssh-ed25519 SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The private key file is secrets/backup-sftp-key (mounted at /run/secrets/backup-sftp-key):
# NODERA_BACKUP_SFTP_KEY_FILE=/run/secrets/backup-sftp-key
