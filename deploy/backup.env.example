# Configuration for scripts/backup-nodera.sh (backup of Nodera ITSELF). /etc/nodera/backup.env, 0640.
# Values only; the SFTP private key and the age IDENTITY (private key) are never stored here.
NODERA_DR_AGE_RECIPIENT=age1replacewithyourpublickey
NODERA_DR_SFTP_TARGET=uXXXXXX@uXXXXXX.your-storagebox.de
NODERA_DR_SFTP_PORT=23
NODERA_DR_SFTP_KEY=/etc/nodera/dr/sftp_key
NODERA_DR_KNOWN_HOSTS=/etc/nodera/dr/known_hosts
NODERA_DR_REMOTE_DIR=nodera-dr
NODERA_DR_KEEP=14
NODERA_DR_LOCAL_DIR=/var/backups/nodera
NODERA_DR_COMPOSE_DIR=/opt/nodera
NODERA_DR_ENV_FILE=/etc/nodera/nodera.env
